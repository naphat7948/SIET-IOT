from machine import Pin
import time

# กำหนดขาที่จะส่งสัญญาณไปที่หลอด
led_red = Pin(21, Pin.OUT)

# ฟังก์ชั่นในการเปิดไฟ
def main():
    # เปิดค้างไว้
    while True:
        # เปิดไฟ
        led_red.value(1)
        time.sleep(1) #หน่วงเวลา 1 วินาที

        # ปิดไฟ
        led_red.value(0)
        time.sleep(1) #หน่วงเวลา 1 วินาที

# เรียกใช้ฟังก์ชั่น main
main()
