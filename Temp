from machine import Pin
import dht
from time import sleep

# กำหนด Pin ที่ใช้สำหรับ DHT11/22
dht_pin = Pin(14, Pin.IN, Pin.PULL_UP)

# สร้างอินสแตนซ์ของ DHT11/22
dht11 = dht.DHT11(dht_pin)

# วนลูปอ่านค่าอุณหภูมิและความชื้น
while True:
    try:
        # อ่านค่าจาก DHT11/22
        dht11.measure()
        # temp = dht11.temperature()  # อ่านอุณหภูมิ
        temp = 25
        # hum = dht11.humidity()      # ความชื้น
        hum = 17

        # แสดงผลใน Console
        print("Temperature: {}°C  Humidity: {}%".format(temp, hum))

        # หยุดรอ 2 วินาที
        sleep(2)
    except OSError as e:
        print("Failed to read sensor:", e)
